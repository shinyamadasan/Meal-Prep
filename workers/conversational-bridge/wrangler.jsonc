{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-prep-conversational-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
  // Secrets (never committed, never in `vars`): set with `wrangler secret put <NAME>` before any
  // real deploy. See README.md "Required secrets". This file intentionally carries no `vars` block
  // — unlike recipe-import's ALLOWED_ORIGINS, every configuration value this Worker needs is
  // sensitive (bearer token, service-account credential, target uid).
}
