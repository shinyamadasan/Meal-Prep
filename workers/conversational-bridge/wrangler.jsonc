{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-prep-conversational-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // TASK-092 (PROP-041 owner decision 1): the household calendar day for food-safety verdicts.
  // One non-secret setting for the whole household, an IANA time zone. Invalid => reads fail.
  "vars": {
    "HOUSEHOLD_TIME_ZONE": "Asia/Manila"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "04b3e16f2de84bb6b6c0b3ef2ea971cd"
    }
  ]
  // Secrets and owner identity configuration (never committed, never in `vars`) are listed in
  // README.md "Required secrets". TASK-068 adds only the independently reviewed, non-secret
  // OAUTH_KV namespace binding here.
}
