{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-prep-conversational-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
  // Secrets and owner identity configuration (never committed, never in `vars`) are listed in
  // README.md "Required secrets". The separately authorized TASK-068 provisioning step must add
  // the non-secret OAUTH_KV namespace binding after independent review; no live namespace exists.
}
